# Copy to .env on the VM. No paid vendors. All self-hosted free.
PB_URL=http://localhost:8090
PB_ADMIN_EMAIL=admin@example.org
PB_ADMIN_PASSWORD=change-me-32-chars-min

# Web Push VAPID (generate once: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.org

# Self SMTP (Postal/Postfix on VM) or Gmail fallback 500/d. Optional.
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USER=
SMTP_PASS=
SMTP_FROM=QAF Support <no-reply@example.org>

# LLM: ollama local unlimited. Optional Gemini free fallback (no card).
LLM_PROVIDER=ollama
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b-instruct-q4_K_M
GEMINI_API_KEY=

# Pilot
TZ=Africa/Lagos
COHORT_ID=pilot-2026-01
ADMIN_WHATSAPP_E164=
SITE_URL=https://qaf.example.org
